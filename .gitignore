# Local configuration and secrets - never commit these
.env
.env.*
!.env.example
*.pem
*.key
kubeconfig*
secrets.yaml
*-secret.yaml

# Generated by scripts/deploy.sh (release-specific image pins)
.deploy/

# Terraform: local working directories, state (it contains secrets) and
# environment-specific inputs. The provider lock files ARE committed.
**/.terraform/
*.tfstate
*.tfstate.*
*.tfplan
crash.log
crash.*.log
*.tfvars
!*.tfvars.example
terraform/eks/backend.hcl

# Editor / OS
.vscode/
.idea/
.DS_Store
