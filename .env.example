# Copy to .env (git-ignored) and replace every placeholder.
# Generate a password with: openssl rand -base64 24

# Path to the application repository (frontend + backend source).
APP_REPO_PATH=../todo-app

DB_NAME=todo
DB_USER=todo
DB_PASSWORD=

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=

# Host ports (bound to 127.0.0.1 only).
HTTP_PORT=8080
PROMETHEUS_PORT=9090
GRAFANA_PORT=3001
